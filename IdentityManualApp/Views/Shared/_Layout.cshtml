<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Perfumes</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Perfumes</a>
            <ul class="navbar-links">
                <li><a asp-controller="Fornecedor" asp-action="Index">Fornecedores</a></li>
                <li><a asp-controller="Produto" asp-action="Index">Produtos</a></li>
                <li><a asp-controller="Receita" asp-action="Index">Receitas</a></li>
                <li><a asp-controller="Perfume" asp-action="Index">Perfumes</a></li>
                <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            </ul>
            <ul class="navbar-account">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="user-name">Olá, @User.Identity.Name</li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="link-button">Sair</button>
                        </form>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Entrar</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Cadastrar</a></li>
                }
            </ul>
        </nav>
    </header>

    <main class="container">
        @if (TempData["Mensagem"] != null)
        {
            <div class="alert alert-success">@TempData["Mensagem"]</div>
        }
        @RenderBody()
    </main>

    <footer class="">
        <p>&copy; @DateTime.Now.Year - Perfumes</p>
    </footer>
</body>
</html>
