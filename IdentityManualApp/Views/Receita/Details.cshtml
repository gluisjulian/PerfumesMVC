@model PerfumesMVC.Models.Receita;

@{
    ViewData["Title"] = "Detalhes da Receita";
}


<h2>
    Detalhes da Receita
</h2>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <h3>Titulo</h3>
            <p>@Model.Titulo</p>
            <hr />

            <h3>Titulo</h3>
            <p>@Model.Descricao</p>
            <hr />
        </dl>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h1>Produtos da Receita</h1>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        Produto
                    </th>
                    <th>
                        Quantidade
                    </th>
                    <th>
                        Unidade
                    </th>
                    <th>
                        %
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ReceitaProdutos)
                {
                    <tr>
                        <td>
                            @item.Produto.Nome
                        </td>
                        <td>
                            @item.Quantidade
                        </td>
                        <td>
                            @item.UnidadeMedida
                        </td>
                        <td>
                            @item.PorcentagemProduto %
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary"> Voltar </a>
</div>
