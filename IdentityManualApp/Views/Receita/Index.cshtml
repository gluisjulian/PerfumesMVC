@model IEnumerable<PerfumesMVC.Models.Receita>

@{
    ViewData["Title"] = "Receitas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Receitas</h2>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i>
        Nova Receita
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhuma receita cadastrada.
    </div>
}
else
{
    <table class="table table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Descrição</th>
                @* <th width="120">Produtos</th> *@
                <th width="220" class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var receita in Model)
            {
                <tr>
                    <td>
                        @receita.Titulo
                    </td>
                    <td>
                        @receita.Descricao
                    </td>
                    @* <td class="text-center">
                        @receita.ReceitaProdutos.Count
                    </td> *@
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@receita.Id">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@receita.Id">Editar</a>
                        <a asp-action="Delete" asp-route-id="@receita.Id">Excluir</a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
}
