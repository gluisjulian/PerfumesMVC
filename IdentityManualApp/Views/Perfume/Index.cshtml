@model IEnumerable<PerfumesMVC.Models.Perfume>

@{
    ViewData["Title"] = "Meus Perfumes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Meus Perfumes</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Novo Perfume
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum perfume cadastrado ainda. <a asp-action="Create">Cadastre o primeiro</a>.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var perfume in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (perfume.ImagemDados != null)
                    {
                        <img src="@Url.Action("Imagem", new { id = perfume.Id })"
                             class="card-img-top"
                             style="height: 220px; object-fit: cover;"
                             alt="@perfume.Nome" />
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                             style="height: 220px;">
                            <i class="bi bi-image text-muted" style="font-size: 2.5rem;"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@perfume.Nome</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(perfume.Descricao?.Length > 80
                                ? perfume.Descricao.Substring(0, 80) + "..."
                                : perfume.Descricao)
                        </p>

                        <div class="d-flex gap-2 mt-2">
                            <a asp-action="Edit" asp-route-id="@perfume.Id">Editar</a>
                            <a asp-action="Details" asp-route-id="@perfume.Id">Detalhes</a>
                            <a asp-action="Delete" asp-route-id="@perfume.Id">Excluir</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}