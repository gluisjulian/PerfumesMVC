@model Produto
@{
    ViewData["Title"] = "Editar produto";
}

<div class="form-container">
    <h1>Editar produto</h1>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UsuarioId" />

        <div class="form-group">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" rows="3"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Preco"></label>
            <input asp-for="Preco" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Quantidade"></label>
            <input asp-for="Quantidade" />
            <span asp-validation-for="Quantidade" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FornecedorId"></label>
            <select asp-for="FornecedorId" asp-items="ViewBag.FornecedorId">
                <option value="">-- Selecione --</option>
            </select>
            <span asp-validation-for="FornecedorId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">Salvar</button>
        <a asp-action="Index" class="btn" style="background:#6b7280">Cancelar</a>
    </form>
</div>
